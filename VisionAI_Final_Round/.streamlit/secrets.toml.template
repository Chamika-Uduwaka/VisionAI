[#] Template for Streamlit secrets. Copy to `.streamlit/secrets.toml` and fill in your keys.

[GEMINI]
GEMINI_API_KEY = "<YOUR_GEMINI_API_KEY_HERE>"

[GOOGLE]
GOOGLE_API_KEY = "<YOUR_GOOGLE_API_KEY_HERE>"

# Example usage (Windows PowerShell):
# setx GEMINI_API_KEY "your_key_here"
# OR create the file and paste the keys in TOML form.